{
  "name": "nzaidi-sistema",
  "private": true,
  "description": "Sistema digital da NZAIDI – Casa de Câmbios & Transferência",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/site-publico"
  ],
  "scripts": {
    "verificar:tipos": "tsc -b",
    "verificar:docs": "python scripts/verificar-documentacao.py",
    "testes": "vitest run",
    "build:site": "npm --workspace=@nzaidi/site-publico run build",
    "verificar": "npm run verificar:tipos && npm run testes && npm run verificar:docs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
