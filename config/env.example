# MODELO de variáveis de ambiente. Copiar para .env (que NÃO vai para o Git).
# Todos os valores abaixo são marcadores. Nunca escrever valores reais neste ficheiro.

# --- Ambiente ---
AMBIENTE=desenvolvimento            # desenvolvimento | teste | staging | producao
URL_BASE_APP=                       # endereço público da aplicação do cliente
URL_BASE_ADMIN=                     # endereço da área administrativa

# --- Base de dados ---
BASE_DADOS_URL=                     # ligação à base de dados (segredo)

# --- Segurança ---
CHAVE_CIFRA_DADOS=                  # chave para cifrar dados sensíveis em repouso (segredo)
SEGREDO_SESSAO=                     # segredo das sessões (segredo)

# --- Wise (CONDICIONADO ao acordo de parceria) ---
WISE_AMBIENTE=sandbox               # sandbox | producao
WISE_CLIENT_ID=
WISE_CLIENT_SECRET=
WISE_REDIRECT_URI=
WISE_WEBHOOK_CHAVE_PUBLICA=

# --- Meio de pagamento em kwanzas (CONDICIONADO: fornecedor por escolher) ---
PAGAMENTOS_FORNECEDOR=
PAGAMENTOS_CHAVE_API=
PAGAMENTOS_SEGREDO_WEBHOOK=

# --- Remessas (CONDICIONADO: especificações por receber) ---
MAXPAY_URL=
MAXPAY_CHAVE=
MAXPAY_SEGREDO=
REALTRANSFERS_URL=
REALTRANSFERS_CHAVE=
REALTRANSFERS_SEGREDO=

# --- Verificação de listas de risco (CONDICIONADO: fornecedor por escolher) ---
SCREENING_FORNECEDOR=
SCREENING_CHAVE_API=

# --- Reportes BNA ---
REPORTE_BNA_HORA=18:30              # hora de Luanda (confirmado)
